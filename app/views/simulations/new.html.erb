<% content_for :title, "Nouvelle simulation" %>

<div class="sim-app"
       data-controller="simulation"
       data-simulation-current-step-value="<%= @current_step || 0 %>">
  <div class="sim-header">
    <h1 class="sim-title">Simulateur de contrôle de fiche de paie</h1>
    <p class="sim-subtitle">
      Calculez votre rémunération IADE AP-HP théorique et comparez-la à votre bulletin reçu.
    </p>

    <nav class="stepper" data-simulation-target="stepper">
      <%= render "shared/step_item", num: "0", label: "Période",   step: 0, current: @current_step %>
      <%= render "shared/step_item", num: "1", label: "Situation", step: 1, current: @current_step %>
      <%= render "shared/step_item", num: "2", label: "Résidence", step: 2, current: @current_step %>
      <%= render "shared/step_item", num: "3", label: "Indemnités",step: 3, current: @current_step %>
      <%= render "shared/step_item", num: "4", label: "Activité",  step: 4, current: @current_step %>
      <%= render "shared/step_item", num: "5", label: "Primes",    step: 5, current: @current_step %>
      <%= render "shared/step_item", num: "6", label: "Retenues",  step: 6, current: @current_step %>
    </nav>

    <div class="progress-label">
      <span>Progression de la saisie</span>
      <span class="confidence" data-simulation-target="confidenceLabel">0%</span>
    </div>
    <div class="progress-bar">
      <div class="progress-fill" data-simulation-target="progressFill" style="width:0%"></div>
    </div>
  </div>

  <div class="sim-layout">
    <div class="sim-main">
      <%= form_with model: @simulation, url: simulations_path, multipart: true,
            data: { simulation_target: "form",
                    action: "input->simulation#updateSidebar change->simulation#updateSidebar input->simulation#updateProgress change->simulation#updateProgress" } do |f| %>

        <%# Masqué temporairement (pas encore jugé assez abouti pour être exposé aux agents) —
            code conservé intact, il suffit de retirer la classe "hidden" pour réactiver. %>
        <div class="step-panel hidden" style="margin-bottom:1.5rem">
          <div class="panel-header">
            <div class="panel-icon">📎</div>
            <div class="panel-titles">
              <h2 class="panel-title">Importer un bulletin existant (optionnel)</h2>
              <p class="panel-desc">
                Pré-remplit automatiquement mois, statut, échelon, quotité, profession et grade
                — le reste du formulaire reste à compléter. Tous les champs restent modifiables.
              </p>
            </div>
          </div>
          <div class="panel-body">
            <%= f.file_field :bulletin_pdf,
                  accept: "application/pdf,image/jpeg,image/png,image/heic",
                  data: { simulation_target: "bulletinInput", action: "change->simulation#uploadBulletin" } %>
            <div class="alert hidden" data-simulation-target="extractBanner" style="margin-top:1rem"></div>
          </div>
        </div>

        <% Iade::Ocr::BulletinExtractor::KNOWN_CODES.each_key do |code| %>
          <input type="hidden" name="real_lines[<%= code %>]" data-simulation-target="realLineField" data-code="<%= code %>">
        <% end %>
        <input type="hidden" name="real[brut]" data-simulation-target="realBrutField">
        <input type="hidden" name="real[net]" data-simulation-target="realNetField">

        <div data-simulation-target="panel" data-step="0" class="<%= @current_step == 0 ? '' : 'hidden' %>">
          <%= render "simulations/steps/step_0", f: f %>
        </div>

        <div data-simulation-target="panel" data-step="1" class="hidden">
          <%= render "simulations/steps/step_1", f: f %>
        </div>

        <div data-simulation-target="panel" data-step="2" class="hidden">
          <%= render "simulations/steps/step_2", f: f %>
        </div>

        <div data-simulation-target="panel" data-step="3" class="hidden">
          <%= render "simulations/steps/step_3", f: f %>
        </div>

        <div data-simulation-target="panel" data-step="4" class="hidden">
          <%= render "simulations/steps/step_4", f: f %>
        </div>

        <div data-simulation-target="panel" data-step="5" class="hidden">
          <%= render "simulations/steps/step_5", f: f %>
        </div>

        <div data-simulation-target="panel" data-step="6" class="hidden">
          <%= render "simulations/steps/step_6", f: f %>
        </div>

      <% end %>
    </div>

    <aside class="live-sidebar">
      <%= render "simulations/live_sidebar" %>
    </aside>
  </div>
</div>
