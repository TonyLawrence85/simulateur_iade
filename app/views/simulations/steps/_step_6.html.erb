<div class="step-panel">
  <div class="panel-header">
    <div class="panel-icon">🧾</div>
    <div class="panel-titles">
      <h2 class="panel-title">Retenues personnelles</h2>
      <p class="panel-desc">
        CNRACL/IRCANTEC, CSG et RAFP sont calculées automatiquement. Saisissez votre taux PAS.
      </p>
    </div>
    <span class="panel-step-counter">Étape 6 / 7</span>
  </div>

  <div class="panel-body">

    <div class="section-label">Prélèvement à la source</div>

    <div class="field-grid field-grid--2">
      <div class="field-group">
        <%= f.label :taux_pas, class: "field-label" do %>
          Taux PAS personnalisé <span class="req">*</span> <span class="badge badge--var">Q60</span>
        <% end %>
        <%= f.number_field :taux_pas, placeholder: "Ex : 6.20", step: 0.01, min: 0, max: 100, required: true %>
        <span class="field-hint">Votre taux personnalisé — ligne Q60 du bulletin</span>
      </div>
      <div class="field-group">
        <%= f.label :cumul_hs_brut_anterieur, class: "field-label" do %>
          Cumul heures sup. brutes depuis janvier (optionnel)
        <% end %>
        <%= f.number_field :cumul_hs_brut_anterieur, placeholder: "0,00", step: 0.01, min: 0 %>
        <span class="field-hint">
          L'exonération fiscale des heures sup est plafonnée à 7 500 €/an. Si vous en faites
          beaucoup, additionnez les montants IT7 + DHN (+ TP7/TP8 le cas échéant) de vos
          bulletins depuis janvier (hors mois en cours) et indiquez le total ici pour une base
          Q60 exacte — sinon, laissez à 0.
        </span>
      </div>
    </div>

    <div class="section-label">Retenues facultatives</div>

    <div class="field-grid field-grid--2">
      <div class="field-group">
        <%= f.label :mutuelle, "Mutuelle / prévoyance", class: "field-label" %>
        <%= f.number_field :mutuelle, placeholder: "0,00", step: 0.01, min: 0 %>
        <span class="field-hint">Pour coller exactement au net à payer</span>
      </div>
    </div>

    <div class="section-label" style="margin-top:1.25rem">
      Prochaine évolution de carrière <span class="badge badge--calc">indicatif</span>
    </div>
    <div class="result-kpis" style="grid-template-columns:repeat(auto-fit,minmax(180px,1fr))">
      <div class="result-kpi">
        <p class="rk-label">Échelon actuel</p>
        <p class="rk-value" data-simulation-target="carriereEchelonActuel">—</p>
        <p class="rk-sub" data-simulation-target="carriereTibActuelSub"></p>
      </div>

      <div class="result-kpi" data-simulation-target="carriereBlockSuivant">
        <p class="rk-label">Prochain échelon</p>
        <p class="rk-value rk-positive" data-simulation-target="carriereEchelonSuivant">—</p>
        <p class="rk-sub" data-simulation-target="carriereDeltaTibSub"></p>
      </div>

      <div class="result-kpi" data-simulation-target="carriereBlockDate">
        <p class="rk-label">Date estimée</p>
        <p class="rk-value" data-simulation-target="carriereDateEstimee">—</p>
        <p class="rk-sub" data-simulation-target="carriereMoisRestantsSub"></p>
      </div>

      <div class="result-kpi hidden" data-simulation-target="carriereBlockTerminal">
        <p class="rk-label">Avancement</p>
        <p class="rk-value" style="font-size:1rem">Échelon terminal</p>
        <p class="rk-sub">Dernier échelon de votre grade</p>
      </div>
    </div>
    <span class="field-hint" data-simulation-target="carriereNoDateHint" style="display:none">
      Saisissez la date de prise d'effet de l'échelon actuel (étape « Situation ») pour estimer la date du prochain échelon.
    </span>
  </div>

  <div class="panel-footer">
    <button type="button" class="btn btn--secondary" data-action="click->simulation#prevStep">← Précédent</button>
    <button type="submit" class="btn btn--success btn--lg">Lancer la simulation →</button>
  </div>
</div>
