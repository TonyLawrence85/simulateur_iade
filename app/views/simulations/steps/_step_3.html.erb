<div class="step-panel">
  <div class="panel-header">
    <div class="panel-icon">💶</div>
    <div class="panel-titles">
      <h2 class="panel-title">NBI et indemnités fixes</h2>
      <p class="panel-desc">
        CTI, prime Veil et prime IADE sont automatiques. Saisir les éléments profil depuis un bulletin récent.
      </p>
    </div>
    <span class="panel-step-counter">Étape 3 / 7</span>
  </div>

  <div class="panel-body">
    <div class="section-label">NBI — Nouvelle bonification indiciaire</div>

    <div class="field-grid field-grid--2 hidden" data-visible-when="mode:expert">
      <div class="field-group">
        <%= f.label :nbi_points, class: "field-label" do %>
          Points NBI
        <% end %>
        <%= f.select :nbi_points, [["0 — aucune", 0], ["10 points", 10], ["15 points", 15], ["20 points", 20]], { selected: @simulation.nbi_points }, data: { action: "change->simulation#updateNbi" } %>
        <span class="field-hint">Chercher <code>BONIFICATION IND.</code> (KB1) sur le bulletin</span>
      </div>

      <div class="field-group">
        <label class="field-label">Montant NBI calculé <span class="badge badge--calc">KB1</span></label>
        <input type="text" disabled class="field-computed" data-simulation-target="nbiDisplay" value="0,00 €"> <%# herb:disable all %>
      </div>
    </div>

    <div class="section-label">Indemnités profil (lire sur un bulletin récent)</div>

    <div class="field-grid field-grid--2">
      <div class="field-group hidden" data-visible-when="mode:expert">
        <%= f.label :iss_montant, class: "field-label" do %>
          ISS — Ind. spécifique sujétion <span class="badge badge--calc">IS1</span>
        <% end %>
        <%= f.number_field :iss_montant, placeholder: "Auto-calculé si vide", step: 0.01, min: 0 %>
        <span class="field-hint">Calculé automatiquement (13/1900 × 12 × (TIB+IR)). Saisir uniquement pour forcer une valeur.</span>
      </div>

      <div class="field-group hidden" data-visible-when="mode:expert">
        <label class="field-label">
          Ligne DTC ou DTF sur bulletin <span class="badge badge--profile">DTC</span>
        </label>
        <div class="radio-toggle">
          <label class="radio-toggle__option">
            <input type="radio" name="has_dtc" value="non"
              data-action="change->simulation#dtcToggle"
              <%= @simulation.dtc_montant.present? ? "" : "checked" %>>
            Non
          </label>
          <label class="radio-toggle__option">
            <input type="radio" name="has_dtc" value="oui"
              data-action="change->simulation#dtcToggle"
              <%= @simulation.dtc_montant.present? ? "checked" : "" %>>
            Oui
          </label>
        </div>
        <span class="field-hint">Avez-vous une ligne DTC ou DTF sur votre bulletin de salaire ?</span>
        <div data-simulation-target="dtcMontantRow"
             style="<%= @simulation.dtc_montant.present? ? "" : "display:none" %>; margin-top:0.5rem">
          <%= f.number_field :dtc_montant, placeholder: "Montant observé sur bulletin M−1 (ex : 44,18)", step: 0.01, min: 0 %>
          <span class="field-hint field-hint--warn">Saisir le montant mensuel de votre dernier bulletin (M−1)</span>
        </div>
      </div>

    </div>

    <div class="section-label" style="margin-top:1.25rem">
      Transport — Remboursement Navigo <span class="badge badge--profile">WT1</span>
    </div>

    <%# Question A — gate %>
    <div class="field-grid field-grid--1">
      <div class="field-group">
        <label class="field-label">Avez-vous un abonnement de transport en commun pour venir travailler ?</label>
        <div class="radio-toggle">
          <label class="radio-toggle__option">
            <input type="radio" name="simulation_session[wt1_a_abonnement]" value="non"
              data-action="change->simulation#wt1AbonnementToggle"
              <%= @simulation.wt1_a_abonnement.in?(%w[oui nsp]) ? "" : "checked" %>>
            Non
          </label>
          <label class="radio-toggle__option">
            <input type="radio" name="simulation_session[wt1_a_abonnement]" value="oui"
              data-action="change->simulation#wt1AbonnementToggle"
              <%= @simulation.wt1_a_abonnement == "oui" ? "checked" : "" %>>
            Oui
          </label>
          <label class="radio-toggle__option">
            <input type="radio" name="simulation_session[wt1_a_abonnement]" value="nsp"
              data-action="change->simulation#wt1AbonnementToggle"
              <%= @simulation.wt1_a_abonnement == "nsp" ? "checked" : "" %>>
            Je ne sais pas
          </label>
        </div>
        <span class="field-hint" data-simulation-target="wt1NspHint" style="<%= @simulation.wt1_a_abonnement == "nsp" ? "" : "display:none" %>">
          Seuls les abonnements éligibles sont remboursés ; les tickets à l'unité ne le sont pas.
        </span>
      </div>
    </div>

    <div data-simulation-target="wt1DetailRows" style="<%= @simulation.wt1_a_abonnement == "oui" ? "" : "display:none" %>">
      <%# Question B — type d'abonnement %>
      <div class="field-grid field-grid--1" style="margin-top:0.75rem">
        <div class="field-group">
          <%= f.label :type_navigo, "Quel abonnement utilisez-vous ?", class: "field-label" %>
          <%= f.select :type_navigo,
                [["Navigo annuel", "annuel"], ["Navigo mois", "mensuel"], ["Navigo semaine", "semaine"], ["Autre abonnement", "autre"]],
                { selected: @simulation.type_navigo.presence || "mensuel" },
                data: { action: "change->simulation#navigoTypeToggle" } %>
        </div>
      </div>

      <%# Question C — zones (Navigo annuel/mois/semaine) %>
      <div class="field-grid field-grid--2" data-simulation-target="navigoZonesRow"
           style="margin-top:0.75rem; <%= @simulation.type_navigo == "autre" ? "display:none" : "" %>">
        <div class="field-group">
          <%= f.label :wt1_zones, "Quelles zones sont nécessaires pour votre trajet domicile-travail ?", class: "field-label" %>
          <%= f.select :wt1_zones,
                [["Toutes zones 1-5", "1-5"], ["Zones 2-3", "2-3"], ["Zones 3-4", "3-4"], ["Zones 4-5", "4-5"]],
                { selected: @simulation.wt1_zones, include_blank: "— Choisir —" },
                data: { action: "change->simulation#updateSidebar" } %>
          <span class="field-hint">Référence Navigo annuel Île-de-France Mobilités 2026 des mêmes zones, quel que soit le pass détenu</span>
        </div>
      </div>

      <%# Question B (suite) — Autre abonnement : mode avancé %>
      <div class="field-grid field-grid--1" data-simulation-target="navigoAutreRow"
           style="margin-top:0.75rem; <%= @simulation.type_navigo == "autre" ? "" : "display:none" %>">
        <div class="field-group">
          <%= f.label :wt1_montant, "Montant mensuel de l'abonnement (justificatif)", class: "field-label" %>
          <%= f.number_field :wt1_montant, placeholder: "Ex : 86,40", step: 0.01, min: 0,
                data: { action: "input->simulation#updateSidebar" } %>
          <span class="field-hint">Mode avancé — montant observé sur votre justificatif d'abonnement</span>
        </div>
      </div>

      <%# Question D — profil nuit %>
      <div class="field-grid field-grid--1" style="margin-top:0.75rem">
        <div class="field-group">
          <label class="field-label">Votre profil AP-HP est-il reconnu comme personnel de nuit ou alternance jour/nuit ouvrant droit au remboursement à 100% ?</label>
          <div class="radio-toggle">
            <label class="radio-toggle__option">
              <input type="radio" name="simulation_session[wt1_nuit_eligible]" value="non"
                data-action="change->simulation#updateSidebar"
                <%= @simulation.wt1_nuit_eligible.in?(%w[oui nsp]) ? "" : "checked" %>>
              Non
            </label>
            <label class="radio-toggle__option">
              <input type="radio" name="simulation_session[wt1_nuit_eligible]" value="oui"
                data-action="change->simulation#updateSidebar"
                <%= @simulation.wt1_nuit_eligible == "oui" ? "checked" : "" %>>
              Oui
            </label>
            <label class="radio-toggle__option">
              <input type="radio" name="simulation_session[wt1_nuit_eligible]" value="nsp"
                data-action="change->simulation#updateSidebar"
                <%= @simulation.wt1_nuit_eligible == "nsp" ? "checked" : "" %>>
              Je ne sais pas
            </label>
          </div>
          <span class="field-hint">« Je ne sais pas » → calcul prudent à 75%, variante 100% affichée à titre indicatif</span>
        </div>
      </div>

      <div class="field-grid field-grid--2" style="margin-top:0.75rem">
        <div class="field-group">
          <label class="field-label">Remboursement estimé <span class="badge badge--calc">WT1</span></label>
          <input type="text" disabled class="field-computed" data-simulation-target="wt1Display" value="—">
          <span class="field-hint">Nuit = 100% · Jour = 75% · Quotité &lt; 50% → ÷2 · &gt;60j absence → 0 €</span>
        </div>
      </div>
    </div>

    <div class="hidden" data-visible-when="mode:expert">
    <div class="section-label" style="margin-top:1.25rem">
      Forfait Mobilités Durables <span class="badge badge--profile">FMD</span>
    </div>

    <div class="field-grid field-grid--1">
      <div class="field-group">
        <label class="field-label">Simuler le FMD de fin d'année ?</label>
        <div class="radio-toggle">
          <label class="radio-toggle__option">
            <input type="radio" name="simulation_session[simulate_fmd]" value="0"
              data-action="change->simulation#fmdToggle"
              <%= @simulation.simulate_fmd? ? "" : "checked" %>>
            Non
          </label>
          <label class="radio-toggle__option">
            <input type="radio" name="simulation_session[simulate_fmd]" value="1"
              data-action="change->simulation#fmdToggle"
              <%= @simulation.simulate_fmd? ? "checked" : "" %>>
            Oui
          </label>
        </div>
        <span class="field-hint">Le FMD est versé sur le bulletin d'octobre ou novembre de l'année N+1</span>
      </div>
    </div>

    <div data-simulation-target="fmdRow"
         style="<%= @simulation.simulate_fmd? ? "" : "display:none" %>; margin-top:0.75rem">
      <div class="field-grid field-grid--2">
        <div class="field-group">
          <%= f.label :fmd_mode, "Mode de déplacement utilisé", class: "field-label" %>
          <%= f.select :fmd_mode,
                [["Vélo / Vélo électrique", "velo"],
                 ["Trottinette", "trottinette"],
                 ["Covoiturage — conducteur", "covoit_conducteur"],
                 ["Covoiturage — passager", "covoit_passager"],
                 ["Service de mobilité partagée", "mobilite_partagee"],
                 ["Autre", "autre"]],
                { selected: @simulation.fmd_mode, include_blank: "— Choisir —" },
                data: { action: "change->simulation#updateFmd" } %> <%# herb:disable all %>
        </div>

        <div class="field-group">
          <%= f.label :fmd_jours_annee, "Nombre de jours/an avec ce mode", class: "field-label" %>
          <%= f.number_field :fmd_jours_annee, placeholder: "Ex : 120", step: 1, min: 0, max: 260,
                data: { action: "input->simulation#updateFmd" } %>
          <span class="field-hint">Jours travaillés en utilisant ce mode de déplacement</span>
        </div>
      </div>

      <div class="alert alert--info" style="margin-top:0.5rem">
        <span>ℹ</span>
        <div>
          <strong>Barème FMD :</strong>
          &lt;30j → 0 € · 30–59j → 100 € · 60–99j → 200 € · ≥100j → 300 €<br>
          <span data-simulation-target="fmdEstimate"></span>
        </div>
      </div>
    </div>
    </div>

    <div class="section-label" style="margin-top:1.25rem">Absences ce mois-ci</div>

    <div data-simulation-target="absencesList">
      <% absences_seed = @simulation.absences.presence || [] %>
      <% absences_seed.each do |absence| %>
        <%= render "simulations/steps/absence_fields", absence: absence %>
      <% end %>
    </div>

    <template data-simulation-target="absenceTemplate">
      <%= render "simulations/steps/absence_fields", absence: {} %>
    </template>

    <div class="panel-footer" style="justify-content:flex-start; padding:0.75rem 0 0">
      <button type="button" class="btn btn--secondary btn--sm" data-action="click->simulation#addAbsence">+ Ajouter une absence</button>
    </div>

    <span class="field-hint" data-simulation-target="absencesSummary">Aucune absence saisie ce mois-ci.</span>

    <div class="alert alert--warn" style="margin-top:0.5rem">
      <span>⚠</span>
      <div>
        Le calcul automatique des retenues couvre la <strong>maladie ordinaire</strong>
        (carence + CMO 90/50%), le <strong>congé maternité/paternité</strong> et le
        <strong>congé pathologique lié à la grossesse</strong> (maintien à 100%), l'<strong>accident
        de service/travail</strong>, l'<strong>accident de trajet</strong> et la <strong>maladie
        professionnelle</strong> (maintien à 100% si l'imputabilité est reconnue, sinon traitement
        provisoire identique à la maladie ordinaire), le <strong>CLM/CLD</strong> (plein ou
        demi-traitement selon le palier déclaré, primes coupées, jamais de carence) et
        l'<strong>absence non rémunérée</strong> (retenue intégrale sur la rémunération brute). Seule
        <strong>autre absence</strong> reste comptabilisée sans retenue calculée, faute de règle
        précise.
      </div>
    </div>
  </div>

  <div class="panel-footer">
    <button type="button" class="btn btn--secondary" data-action="click->simulation#prevStep">← Précédent</button>
    <button type="button" class="btn btn--primary" data-action="click->simulation#nextStep">Suivant →</button>
  </div>
</div>
