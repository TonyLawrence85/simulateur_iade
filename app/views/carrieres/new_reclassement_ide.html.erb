<% content_for :title, "Reclassement IDE vers IADE" %>

<div class="sim-app">
  <div class="sim-header">
    <h1 class="sim-title">Reclassement IDE → IADE AP-HP</h1>
    <p class="sim-subtitle">Projette votre carrière IDE jusqu'au mois de nomination IADE, puis calcule votre reclassement</p>
  </div>

  <%= form_with model: @carriere_simulation, url: carrieres_path, method: :post, local: true do |f| %>
    <%= hidden_field_tag :kind, "reclassement_ide_iade" %>

    <div class="step-panel">
      <div class="panel-body">

        <div class="section-label">Votre situation actuelle</div>
        <div class="field-grid field-grid--1" data-controller="carriere-form">
          <div class="field-group">
            <label class="field-label">Êtes-vous actuellement IDE ?</label>
            <div class="radio-toggle">
              <label class="radio-toggle__option">
                <input type="radio" name="carriere_simulation[situation_actuelle]" value="aphp" data-action="change->carriere-form#toggle" checked>
                Oui, IDE AP-HP
              </label>
              <label class="radio-toggle__option">
                <input type="radio" name="carriere_simulation[situation_actuelle]" value="public" data-action="change->carriere-form#toggle">
                Oui, IDE public hors AP-HP
              </label>
              <label class="radio-toggle__option">
                <input type="radio" name="carriere_simulation[situation_actuelle]" value="prive" data-action="change->carriere-form#toggle">
                Oui, IDE privé
              </label>
              <label class="radio-toggle__option">
                <input type="radio" name="carriere_simulation[situation_actuelle]" value="ne_sais_pas" data-action="change->carriere-form#toggle">
                Je ne sais pas
              </label>
            </div>
            <span class="field-hint">Si vous êtes en secteur privé sans reprise d'ancienneté validée, un classement simplifié (IADE 1er grade échelon 1) sera appliqué.</span>
          </div>

          <div class="field-grid field-grid--2 hidden" data-carriere-form-target="revealable" data-show-when="aphp,public" style="margin-top:0.75rem">
            <div class="field-group">
              <%= f.label :grade_source, class: "field-label" do %>
                Quel est votre grade IDE actuel ? <span class="req">*</span>
              <% end %>
              <%= f.select :grade_source, [["IDE grade 1", "ide_grade1"], ["IDE grade 2", "ide_grade2"]], { include_blank: "— Choisir —" } %>
            </div>
            <div class="field-group">
              <%= f.label :echelon_source, class: "field-label" do %>
                Quel est votre échelon IDE actuel ? <span class="req">*</span>
              <% end %>
              <%= f.select :echelon_source, (1..11).map { |e| [e, e] }, { include_blank: "— Choisir —" } %>
              <%= render "aide_visuelle" %>
            </div>
            <div class="field-group">
              <%= f.label :mois_echelon_source, class: "field-label" do %>
                Depuis quel mois êtes-vous à cet échelon ? <span class="req">*</span>
              <% end %>
              <%= f.month_field :mois_echelon_source %>
            </div>
            <div class="field-group">
              <%= f.label :mois_nomination, class: "field-label" do %>
                À quel mois pensez-vous devenir IADE AP-HP ? <span class="req">*</span>
              <% end %>
              <%= f.month_field :mois_nomination %>
            </div>
          </div>
        </div>

        <div class="section-label" style="margin-top:1.25rem">Pour le net avant PAS futur</div>
        <div class="field-grid field-grid--2" data-controller="carriere-form">
          <div class="field-group">
            <label class="field-label">Votre établissement IADE sera-t-il en zone Paris (indemnité de résidence 3%) ?</label>
            <div class="radio-toggle">
              <label class="radio-toggle__option">
                <input type="radio" name="carriere_simulation[zone_paris]" value="oui" checked>
                Oui
              </label>
              <label class="radio-toggle__option">
                <input type="radio" name="carriere_simulation[zone_paris]" value="non">
                Non
              </label>
              <label class="radio-toggle__option">
                <input type="radio" name="carriere_simulation[zone_paris]" value="ne_sais_pas">
                Je ne sais pas
              </label>
            </div>
          </div>

          <div class="field-group">
            <%= f.label :nb_enfants_sft, "Enfants ouvrant droit au SFT", class: "field-label" %>
            <%= f.select :nb_enfants_sft, [["0", 0], ["1", 1], ["2", 2], ["3 ou plus", 3]], { selected: 0 } %>
          </div>

          <div class="field-group">
            <%= f.label :quotite, "Quotité de travail prévue comme IADE", class: "field-label" %>
            <%= f.select :quotite, [["100%", 1.0], ["90%", 0.9], ["80%", 0.8], ["50%", 0.5]], { selected: 1.0 } %>
          </div>
        </div>

        <div class="field-grid field-grid--1" data-controller="carriere-form" style="margin-top:0.75rem">
          <div class="field-group">
            <label class="field-label">Aurez-vous la NBI IADE ?</label>
            <div class="radio-toggle">
              <label class="radio-toggle__option">
                <input type="radio" name="carriere_simulation[nbi_choix]" value="oui_15" data-action="change->carriere-form#toggle" checked>
                Oui, 15 points
              </label>
              <label class="radio-toggle__option">
                <input type="radio" name="carriere_simulation[nbi_choix]" value="non" data-action="change->carriere-form#toggle">
                Non
              </label>
              <label class="radio-toggle__option">
                <input type="radio" name="carriere_simulation[nbi_choix]" value="ne_sais_pas" data-action="change->carriere-form#toggle">
                Je ne sais pas
              </label>
              <label class="radio-toggle__option">
                <input type="radio" name="carriere_simulation[nbi_choix]" value="expert" data-action="change->carriere-form#toggle">
                Mode expert (points)
              </label>
            </div>
            <span class="field-hint">15 points par défaut si le poste IADE est éligible NBI à l'AP-HP</span>
          </div>
          <div class="field-group hidden" data-carriere-form-target="revealable" data-show-when="expert">
            <%= f.label :nbi_points_expert, "Nombre de points NBI", class: "field-label" %>
            <%= f.number_field :nbi_points_expert, step: 1, min: 0 %>
          </div>
        </div>

        <div class="field-grid field-grid--1" style="margin-top:0.75rem">
          <div class="field-group">
            <%= f.label :wt1_montant, class: "field-label" do %>
              Remboursement transport mensuel (Navigo ou autre), si vous voulez le voir inclus
            <% end %>
            <%= f.number_field :wt1_montant, placeholder: "Laisser vide pour ne pas inclure le transport", step: 0.01, min: 0 %>
            <span class="field-hint">Optionnel — le résultat affichera le net avant PAS avec et sans transport si renseigné</span>
          </div>
        </div>

        <div class="field-grid field-grid--1" data-controller="carriere-form" style="margin-top:0.75rem">
          <div class="field-group">
            <label class="field-label">Avez-vous une ligne DTC ou DTF sur votre bulletin IDE actuel ?</label>
            <div class="radio-toggle">
              <label class="radio-toggle__option">
                <input type="radio" name="carriere_simulation[dtc_choix]" value="non" data-action="change->carriere-form#toggle" checked>
                Non
              </label>
              <label class="radio-toggle__option">
                <input type="radio" name="carriere_simulation[dtc_choix]" value="dtc" data-action="change->carriere-form#toggle">
                Oui, DTC
              </label>
              <label class="radio-toggle__option">
                <input type="radio" name="carriere_simulation[dtc_choix]" value="dtf" data-action="change->carriere-form#toggle">
                Oui, DTF
              </label>
              <label class="radio-toggle__option">
                <input type="radio" name="carriere_simulation[dtc_choix]" value="ne_sais_pas" data-action="change->carriere-form#toggle">
                Je ne sais pas
              </label>
            </div>
          </div>
          <div class="field-group hidden" data-carriere-form-target="revealable" data-show-when="dtc,dtf">
            <%= f.label :dtc_montant, "Montant mensuel observé (€)", class: "field-label" %>
            <%= f.number_field :dtc_montant, step: 0.01, min: 0 %>
          </div>
        </div>

      </div>

      <div class="panel-footer">
        <%= link_to "← Annuler", carrieres_path, class: "btn btn--secondary" %>
        <%= f.submit "Calculer mon reclassement →", class: "btn btn--primary" %>
      </div>
    </div>
  <% end %>
</div>
