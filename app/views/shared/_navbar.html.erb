<nav class="navbar navbar-expand-sm navbar-light navbar-lewagon">
  <div class="container-fluid">

    <%= link_to root_path, class: "navbar-brand d-flex align-items-center gap-2",
        style: "text-decoration:none" do %>

      <%# Icône bulletin + stéthoscope + croix + checkmark %>
      <svg width="52" height="58" viewBox="0 0 100 130" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Bulletin de paie -->
        <rect x="14" y="0" width="72" height="90" rx="8" fill="#e8f0fb" stroke="#003D8F" stroke-width="1.5"/>
        <!-- Coin plié -->
        <path d="M68 0 L86 18 L68 18 Z" fill="#003D8F" opacity="0.25"/>
        <path d="M68 0 L86 18 L68 18 Z" fill="none" stroke="#003D8F" stroke-width="1.5"/>
        <!-- Symbole € -->
        <text x="50" y="36" text-anchor="middle" font-family="IBM Plex Sans, sans-serif" font-size="20" font-weight="700" fill="#003D8F">€</text>
        <!-- Lignes simulées -->
        <rect x="22" y="46" width="52" height="3" rx="1.5" fill="#003D8F" opacity="0.2"/>
        <rect x="22" y="54" width="38" height="3" rx="1.5" fill="#003D8F" opacity="0.2"/>
        <rect x="22" y="62" width="46" height="3" rx="1.5" fill="#003D8F" opacity="0.2"/>
        <rect x="22" y="70" width="30" height="3" rx="1.5" fill="#003D8F" opacity="0.2"/>
        <!-- Stéthoscope -->
        <path d="M2 32 Q2 72 22 80 Q44 88 52 112" fill="none" stroke="#003D8F" stroke-width="4" stroke-linecap="round"/>
        <path d="M2 32 Q-4 20 -2 12" fill="none" stroke="#003D8F" stroke-width="3" stroke-linecap="round"/>
        <path d="M2 32 Q8 20 10 12" fill="none" stroke="#003D8F" stroke-width="3" stroke-linecap="round"/>
        <circle cx="-2" cy="10" r="4" fill="#003D8F"/>
        <circle cx="10" cy="10" r="4" fill="#003D8F"/>
        <circle cx="52" cy="116" r="12" fill="#003D8F"/>
        <circle cx="52" cy="116" r="8" fill="#e8f0fb"/>
        <circle cx="52" cy="116" r="3.5" fill="#003D8F" opacity="0.4"/>
        <!-- Croix médicale symétrique -->
        <rect x="70" y="15" width="28" height="10" rx="3" fill="#003D8F"/>
        <rect x="79" y="6" width="10" height="28" rx="3" fill="#003D8F"/>
        <rect x="72" y="17" width="24" height="6" rx="2" fill="white"/>
        <rect x="81" y="8" width="6" height="24" rx="2" fill="white"/>
        <!-- Checkmark vert -->
        <circle cx="82" cy="78" r="17" fill="#276749"/>
        <polyline points="73,78 80,86 92,68" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>

      <%# Logotype %>
      <span style="font-family:'IBM Plex Sans',sans-serif;line-height:1.2">
        <span style="display:block;font-size:1rem;font-weight:700;color:#003D8F;letter-spacing:-0.01em">
          Vérifie Paie
        </span>
        <span style="display:block;font-size:0.625rem;font-weight:600;color:#276749;letter-spacing:0.18em;text-transform:uppercase">
          Soignant
        </span>
      </span>

    <% end %>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
            data-bs-target="#navbarSupportedContent"
            aria-controls="navbarSupportedContent"
            aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav me-auto">
        <% if user_signed_in? %>
          <li class="nav-item">
            <%= link_to "Accueil", root_path, class: "nav-link" %>
          </li>
          <li class="nav-item">
            <%= link_to "+ Nouvelle simulation", new_simulation_path, class: "nav-link" %>
          </li>
          <% if current_user.admin? %>
            <li class="nav-item">
              <%= link_to "Admin", admin_simulations_path, class: "nav-link" %>
            </li>
          <% end %>
        <% else %>
          <li class="nav-item">
            <%= link_to "Connexion", new_user_session_path, class: "nav-link" %>
          </li>
          <li class="nav-item">
            <%= link_to "Inscription", new_user_registration_path, class: "nav-link" %>
          </li>
        <% end %>
      </ul>

      <% if user_signed_in? %>
        <ul class="navbar-nav ms-auto align-items-center">
          <li class="nav-item dropdown">
            <button type="button" class="nav-link dropdown-toggle d-flex align-items-center gap-2 btn btn-link p-0"
        style="border:none;background:none"
               id="navbarDropdown" data-bs-toggle="dropdown"
               aria-haspopup="true" aria-expanded="false">
              <div style="width:34px;height:34px;border-radius:50%;
                          background:#003D8F;border:2px solid #276749;
                          display:flex;align-items:center;justify-content:center;
                          color:white;font-weight:700;font-size:.875rem;
                          font-family:'IBM Plex Sans',sans-serif;flex-shrink:0">
                <%= current_user.email[0].upcase %>
              </div>
              <span style="font-size:.8125rem;color:#4a5568;max-width:160px;
                           overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                <%= current_user.email %>
              </span>
            </button>
            <div class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
              <%= link_to "Mes simulations", simulations_path, class: "dropdown-item" %>
              <div class="dropdown-divider"></div>
              <%= link_to "Se déconnecter", destroy_user_session_path,
                  data: { turbo_method: :delete },
                  class: "dropdown-item text-danger" %>
            </div>
          </li>
        </ul>
      <% end %>
    </div>
  </div>
</nav>
