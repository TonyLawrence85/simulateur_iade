<div class="step-panel">
  <div class="panel-header">
    <div class="panel-icon">💰</div>
    <div class="panel-titles">
      <h2 class="panel-title">Primes variables</h2>
      <p class="panel-desc">
        Prime de service (PSR), indemnité exceptionnelle (LSU) et gardes — saisie directe ou calculée.
      </p>
    </div>
    <span class="panel-step-counter">Étape 5 / 7</span>
  </div>

  <div class="panel-body">

    <%# 13e mois AP-HP : PSR + LSU, un seul en-tête, deux sous-questions (règles d'abattement
        distinctes — pas de fusion des montants, cf. audit QA point 5) %>
    <div class="section-label">
      13<sup>e</sup> mois AP-HP <span class="badge badge--var">PSR + LSU</span>
    </div>
    <div class="alert alert--info" style="margin-bottom:1rem">
      <span>ℹ</span>
      <div>Versés en <strong>juin</strong> et <strong>décembre</strong> à l'AP-HP. Saisissez les montants bruts prévus ou observés sur votre bulletin.</div>
    </div>

    <div class="field-grid field-grid--2">
      <div class="field-group">
        <%= f.label :montant_psr, class: "field-label" do %>
          Prime de service (PSR) <span class="badge badge--calc">PSR</span>
        <% end %>
        <%= f.number_field :montant_psr, placeholder: "Ex : 1167.00", step: 0.01, min: 0,
            data: { action: "input->simulation#updateSidebar" } %>
        <span class="field-hint">Laisser vide si le mois n'est pas juin/décembre</span>
      </div>
      <div class="field-group">
        <%= f.label :montant_lsu, class: "field-label" do %>
          Indemnité exceptionnelle (LSU) <span class="badge badge--calc">LSU</span>
        <% end %>
        <%= f.number_field :montant_lsu, placeholder: "Ex : 531.79", step: 0.01, min: 0,
            data: { action: "input->simulation#updateSidebar" } %>
        <span class="field-hint">Laisser vide si absent du bulletin ce mois-ci</span>
      </div>
      <div class="field-group hidden" data-visible-when="mode:expert">
        <%= f.label :jours_absence_psr, "Jours d'absence abattables (PSR)", class: "field-label" %>
        <%= f.number_field :jours_absence_psr, placeholder: "0", step: 1, min: 0,
            data: { action: "input->simulation#updateSidebar" } %>
        <span class="field-hint">Jours CMO abattables → abatt. montant × jours / 140 (PSR uniquement)</span>
      </div>
    </div>

    <%# Primes diverses %>
    <div class="field-grid field-grid--2 hidden" data-visible-when="mode:expert" style="margin-top:1.25rem">
      <div class="field-group">
        <%= f.label :montant_primes_diverses, class: "field-label" do %>
          Primes diverses <span class="badge badge--var">DIV</span>
        <% end %>
        <%= f.number_field :montant_primes_diverses, placeholder: "Ex : 50.00", step: 0.01, min: 0,
            data: { action: "input->simulation#updateSidebar" } %>
        <span class="field-hint">Toute autre prime ou indemnité non couverte ci-dessus (montant brut observé sur bulletin)</span>
      </div>
    </div>

    <%# FT1 - Indemnité tutorat stagiaire : IDE et IADE uniquement %>
    <div class="hidden" data-visible-when="profession:iade,ide">
    <div class="section-label" style="margin-top:1.25rem">
      Indemnité tutorat stagiaire IDE/IADE <span class="badge badge--var">FT1</span>
    </div>
    <div class="field-grid field-grid--1">
      <div class="field-group">
        <label class="field-label">Comment souhaitez-vous saisir l'indemnité tutorat ?</label>
        <div class="radio-toggle">
          <label class="radio-toggle__option">
            <input type="radio" name="simulation_session[ft1_mode]" value="semaines"
              data-action="change->simulation#ft1ModeToggle"
              <%= @simulation.ft1_mode == "montant" ? "" : "checked" %>>
            Nombre de semaines (× 54 €)
          </label>
          <label class="radio-toggle__option">
            <input type="radio" name="simulation_session[ft1_mode]" value="montant"
              data-action="change->simulation#ft1ModeToggle"
              <%= @simulation.ft1_mode == "montant" ? "checked" : "" %>>
            Montant observé sur bulletin
          </label>
        </div>
      </div>
    </div>

    <div class="field-grid field-grid--2" style="margin-top:0.5rem">
      <div class="field-group" data-simulation-target="ft1SemainesRow"
           style="<%= @simulation.ft1_mode == "montant" ? "display:none" : "" %>">
        <%= f.label :ft1_semaines, "Nombre de semaines de tutorat", class: "field-label" %>
        <%= f.number_field :ft1_semaines, placeholder: "0", step: 1, min: 0,
            data: { action: "input->simulation#updateSidebar" } %>
        <span class="field-hint">54 € par semaine de tutorat validée</span>
      </div>
      <div class="field-group" data-simulation-target="ft1MontantRow"
           style="<%= @simulation.ft1_mode == "montant" ? "" : "display:none" %>">
        <%= f.label :ft1_montant, "Montant FT1 brut (€)", class: "field-label" %>
        <%= f.number_field :ft1_montant, placeholder: "Ex : 216.00", step: 0.01, min: 0,
            data: { action: "input->simulation#updateSidebar" } %>
        <span class="field-hint">Montant observé sur votre bulletin</span>
      </div>
    </div>
    </div>

    <%# FT9 - Prime tutorat soignant %>
    <div class="hidden" data-visible-when="mode:expert">
    <div class="section-label" style="margin-top:1.25rem">
      Prime tutorat soignant <span class="badge badge--var">FT9</span>
    </div>
    <div class="field-grid field-grid--1">
      <div class="field-group">
        <label class="field-label">Êtes-vous tuteur de service et bénéficiez-vous de la prime tutorat soignant ?</label>
        <div class="radio-toggle">
          <label class="radio-toggle__option">
            <input type="radio" name="simulation_session[ft9_actif]" value="0"
              data-action="change->simulation#ft9Toggle"
              <%= @simulation.ft9_actif? ? "" : "checked" %>>
            Non
          </label>
          <label class="radio-toggle__option">
            <input type="radio" name="simulation_session[ft9_actif]" value="1"
              data-action="change->simulation#ft9Toggle"
              <%= @simulation.ft9_actif? ? "checked" : "" %>>
            Oui
          </label>
        </div>
        <span class="field-hint">Prime mensuelle fixe de 190 € bruts (≈ 172 € nets)</span>
      </div>
    </div>

    <div class="field-grid field-grid--2" data-simulation-target="ft9MontantRow"
         style="margin-top:0.5rem; <%= @simulation.ft9_actif? ? "" : "display:none" %>">
      <div class="field-group">
        <%= f.label :ft9_montant, "Montant FT9 brut (€)", class: "field-label" %>
        <%= f.number_field :ft9_montant, placeholder: "190.00", step: 0.01, min: 0, value: @simulation.ft9_montant || 190,
            data: { action: "input->simulation#updateSidebar" } %>
        <span class="field-hint">Pré-rempli à 190 € (montant fixe communiqué par l'AP-HP)</span>
      </div>
    </div>
    </div>

    <%# Gardes : profession IADE uniquement %>
    <div class="hidden" data-visible-when="profession:iade">
    <div class="section-label" style="margin-top:1.25rem">
      Gardes <span class="badge badge--var">IT7 / DHN</span>
    </div>
    <div class="alert alert--info" style="margin-bottom:1rem">
      <span>ℹ</span>
      <div>
        À Bichat, une garde = <strong>4 h de heures sup. de nuit</strong> (par défaut). Ces heures
        rejoignent le contingent mensuel de 20h partagé avec les heures sup de nuit saisies en
        étape 4 : payées au tarif nuit tant que le contingent n'est pas dépassé (code
        <code>IT7</code>), puis au <strong>même tarif</strong> au-delà (code <code>DHN</code> —
        pas un taux réduit, juste la part au-delà du plafond). Payées en <strong>M+2</strong>.
      </div>
    </div>

    <div class="field-grid field-grid--2">
      <div class="field-group">
        <%= f.label :nb_gardes, class: "field-label" do %>
          Nombre de gardes (M−2)
        <% end %>
        <%= f.number_field :nb_gardes, placeholder: "0", step: 1, min: 0,
            data: { action: "input->simulation#updateSidebar" } %>
        <span class="field-hint field-hint--warn">Saisir l'activité du mois M−2</span>
      </div>
      <div class="field-group">
        <%= f.label :heures_par_garde, "Heures équivalentes / garde", class: "field-label" %>
        <%= f.number_field :heures_par_garde, placeholder: "4", step: 0.5, min: 0,
            data: { action: "input->simulation#updateSidebar" } %>
        <span class="field-hint">Par défaut : 4 h (Bichat) — à adapter selon votre service</span>
      </div>
    </div>

    <div class="section-label" style="margin-top:1.25rem">
      Heures de weekend de garde <span class="badge badge--var">GAR</span>
    </div>
    <div class="alert alert--info" style="margin-bottom:1rem">
      <span>ℹ</span>
      <div>
        Calcul : nombre d'heures × tarif HS nuit. Contrairement aux gardes ci-dessus, ces heures
        sont payées <strong>hors contingent</strong>, toujours au tarif plein. Activité de
        <strong>M−2</strong>.
      </div>
    </div>

    <div class="field-grid field-grid--2">
      <div class="field-group">
        <%= f.label :heures_weekend_garde, class: "field-label" do %>
          Heures de weekend de garde (M-2)
        <% end %>
        <%= f.number_field :heures_weekend_garde, placeholder: "0", step: 0.5, min: 0,
            data: { action: "input->simulation#updateSidebar" } %>
        <span class="field-hint field-hint--warn">Saisir l'activité du mois M−2</span>
      </div>
    </div>
    </div>

  </div>

  <div class="panel-footer">
    <button type="button" class="btn btn--secondary" data-action="click->simulation#prevStep">← Précédent</button>
    <button type="button" class="btn btn--primary" data-action="click->simulation#nextStep">Suivant →</button>
  </div>
</div>
