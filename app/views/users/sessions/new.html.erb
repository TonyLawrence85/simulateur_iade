<% content_for :title, "Se connecter" %>

<div class="auth-page">
  <div class="auth-card">

    <%# Logo Vérifie Paie Soignant %>
    <div class="auth-logo">
      <svg width="34" height="38" viewBox="0 0 100 130" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="14" y="0" width="72" height="90" rx="8" fill="#e8f0fb" stroke="#003D8F" stroke-width="1.5"/>
        <path d="M68 0 L86 18 L68 18 Z" fill="#003D8F" opacity="0.25"/>
        <path d="M68 0 L86 18 L68 18 Z" fill="none" stroke="#003D8F" stroke-width="1.5"/>
        <text x="50" y="36" text-anchor="middle" font-family="IBM Plex Sans, sans-serif" font-size="20" font-weight="700" fill="#003D8F">€</text>
        <rect x="22" y="46" width="52" height="3" rx="1.5" fill="#003D8F" opacity="0.2"/>
        <rect x="22" y="54" width="38" height="3" rx="1.5" fill="#003D8F" opacity="0.2"/>
        <rect x="22" y="62" width="46" height="3" rx="1.5" fill="#003D8F" opacity="0.2"/>
        <rect x="22" y="70" width="30" height="3" rx="1.5" fill="#003D8F" opacity="0.2"/>
        <path d="M2 32 Q2 72 22 80 Q44 88 52 112" fill="none" stroke="#003D8F" stroke-width="4" stroke-linecap="round"/>
        <path d="M2 32 Q-4 20 -2 12" fill="none" stroke="#003D8F" stroke-width="3" stroke-linecap="round"/>
        <path d="M2 32 Q8 20 10 12" fill="none" stroke="#003D8F" stroke-width="3" stroke-linecap="round"/>
        <circle cx="-2" cy="10" r="4" fill="#003D8F"/>
        <circle cx="10" cy="10" r="4" fill="#003D8F"/>
        <circle cx="52" cy="116" r="12" fill="#003D8F"/>
        <circle cx="52" cy="116" r="8" fill="#e8f0fb"/>
        <circle cx="52" cy="116" r="3.5" fill="#003D8F" opacity="0.4"/>
        <rect x="70" y="15" width="28" height="10" rx="3" fill="#003D8F"/>
        <rect x="79" y="6" width="10" height="28" rx="3" fill="#003D8F"/>
        <rect x="72" y="17" width="24" height="6" rx="2" fill="white"/>
        <rect x="81" y="8" width="6" height="24" rx="2" fill="white"/>
        <circle cx="82" cy="78" r="17" fill="#276749"/>
        <polyline points="73,78 80,86 92,68" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span class="auth-logo__text" style="letter-spacing:normal;line-height:1.2;text-align:left">
        <span style="display:block;font-size:1.05rem;font-weight:700;color:#003D8F;letter-spacing:-0.01em">Vérifie Paie</span>
        <span style="display:block;font-size:0.6875rem;font-weight:600;color:#276749;letter-spacing:0.18em;text-transform:uppercase">Soignant</span>
      </span>
    </div>

    <h1 class="auth-title">Bon retour ! </h1>
    <p class="auth-subtitle">Connectez-vous pour accéder à vos simulations de paie</p>

    <%= form_with model: resource, as: resource_name,
        url: session_path(resource_name), class: "auth-form" do |f| %>

      <div class="auth-field">
        <%= f.label :email, "Email", class: "auth-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
            class: "auth-input", placeholder: "you@aphp.fr" %>
      </div>

      <div class="auth-field">
        <%= f.label :password, "Mot de passe", class: "auth-label" %>
        <%= f.password_field :password, autocomplete: "current-password",
            class: "auth-input", placeholder: "••••••••" %>
      </div>

      <div class="auth-options">
        <label class="auth-remember">
          <%= f.check_box :remember_me, class: "auth-checkbox" %>
          <span>Se souvenir de moi</span>
        </label>
        <% if devise_mapping.recoverable? %>
          <%= link_to "Mot de passe oublié?", new_password_path(resource_name),
              class: "auth-link" %>
        <% end %>
      </div>

      <%= f.submit "Se connecter →", class: "auth-submit" %>

    <% end %>

    <p class="auth-switch">
      Pas encore de compte?
      <%= link_to "Créer un compte maintenant", new_user_registration_path, class: "auth-link auth-link--strong" %>
    </p>

  </div>
</div>
